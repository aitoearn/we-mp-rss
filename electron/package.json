{
  "name": "we-mp-rss-desktop",
  "version": "1.5.2",
  "description": "WeRSS 微信公众号订阅助手 - 桌面版",
  "main": "main.js",
  "homepage": "https://github.com/aitoearn/we-mp-rss",
  "repository": {
    "type": "git",
    "url": "https://github.com/aitoearn/we-mp-rss.git"
  },
  "scripts": {
